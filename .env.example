# Скопируйте в .env и отредактируйте.
DOMAIN=radar.example.com

# Первый администратор (создаётся один раз при первом запуске)
CART3R_ADMIN_EMAIL=you@example.com
CART3R_ADMIN_PASSWORD=замените-на-длинный-пароль

# Ключ, с которым ваши системы отправляют данные (POST /api/transactions, /api/accounts).
# Оставьте пустым, чтобы отключить приём данных по API.
CART3R_API_KEY=

# on = создать демо-данные при первом запуске, off = начать с пустой базы (для реальных данных)
CART3R_SEED=on
# off = скрыть синтетическую «Тестовую лабораторию» в продакшене
CART3R_SIMULATOR=on
